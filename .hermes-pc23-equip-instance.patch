diff --git a/api/combat/[...path].js b/api/combat/[...path].js
index 8e0e0e0..f1a2b3c 100644
--- a/api/combat/[...path].js
+++ b/api/combat/[...path].js
@@ -793,6 +793,70 @@ export async function onRequest(context) {
         return json(res);
       }

+      // 1b. POST /dev/equip-instance (equip specific inventory weapon_instance.id)
+      if (path === '/dev/equip-instance') {
+        const body = await request.json().catch(() => ({}));
+        const instanceId = parseInt(body.instance_id, 10);
+        let slot = body.slot;
+        if (isNaN(instanceId) || instanceId <= 0) return json({ error: 'Invalid instance_id' }, 400);
+        const run = await findActiveRun(user.id);
+        if (!run) return json({ error: 'start a run first' }, 400);
+        if (!slot) {
+          if (!run.hand_l_weapon_id) slot = 'LH';
+          else if (!run.hand_r_weapon_id) slot = 'RH';
+          else if (!run.belt_weapon_id) slot = 'belt';
+          else slot = 'LH';
+        }
+        if (!['LH','RH','belt'].includes(slot)) slot = 'LH';
+        let owns;
+        try {
+          const res = await admin.from('weapon_instance').select('id, user_id, damage, weapon_template:template_id(name)').eq('id', instanceId).eq('user_id', user.id).limit(1);
+          owns = res.data;
+          if (res.error) throw res.error;
+        } catch (e) {
+          console.error('weapon_instance ownership query error', e);
+          return json({ error: 'Internal server error' }, 500);
+        }
+        if (!owns || owns.length === 0) return json({ error: 'weapon not found in your inventory' }, 404);
+        const instData = owns[0];
+        if (run.hand_l_weapon_id === instanceId) return json({ error: `weapon #${instanceId} already equipped in LH` }, 400);
+        if (run.hand_r_weapon_id === instanceId) return json({ error: `weapon #${instanceId} already equipped in RH` }, 400);
+        if (run.belt_weapon_id === instanceId) return json({ error: `weapon #${instanceId} already equipped in belt` }, 400);
+        const col = slot === 'RH' ? 'hand_r_weapon_id' : slot === 'belt' ? 'belt_weapon_id' : 'hand_l_weapon_id';
+        const oldId = run[col];
+        let displaced = null;
+        if (oldId) {
+          try {
+            const { data: oldInst } = await admin.from('weapon_instance').select('id, template_id, weapon_template:template_id(name)').eq('id', oldId).single();
+            if (oldInst) displaced = { instance_id: oldInst.id, template_name: oldInst.weapon_template?.name || 'Unknown' };
+          } catch (_) {}
+        }
+        try {
+          await admin.from('portal_run').update({ [col]: instanceId }).eq('id', run.id).eq('user_id', user.id);
+        } catch (e) {
+          console.error('run weapon pointer update error', e);
+          return json({ error: 'Internal server error' }, 500);
+        }
+        const template_name = instData.weapon_template?.name || 'Unknown';
+        const damage = instData.damage || 15;
+        return json({ slot, weapon: { instance_id: instanceId, template_name, damage }, displaced });
+      }
+
       // 2. POST /dev/roll-weapon
